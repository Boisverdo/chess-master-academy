{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Vérification du code (npm run lint), lancée aussi avant chaque publication.
  // oxlint plutôt qu'ESLint : l'analyseur TypeScript d'ESLint ne prend pas en charge TypeScript 7.
  "plugins": ["react", "typescript"],
  "categories": { "correctness": "error" },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    // Règles propres au « React Compiler », que ce projet n'utilise pas : elles signalent des
    // façons d'écrire (Date.now() au rendu, setState dans un effet…), pas des erreurs.
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react/use-memo": "off"
  },
  "ignorePatterns": ["dist", "test-results", "public/engine", "node_modules"]
}
