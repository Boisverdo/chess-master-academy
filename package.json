{
  "name": "chess-master-academy",
  "private": true,
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src tests scripts vite.config.ts playwright.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "engine": "node scripts/copy-engine.mjs",
    "predev": "node scripts/copy-engine.mjs",
    "prebuild": "node scripts/copy-engine.mjs",
    "pretest:e2e": "node scripts/copy-engine.mjs",
    "test:prod": "node scripts/run-prod-tests.mjs",
    "icons": "node scripts/make-icons.mjs",
    "app": "npm run build && vite preview",
    "test:all": "npm run typecheck && npm run lint && npm test && npm run test:e2e && npm run test:prod"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "chessground": "9.2.1",
    "dexie": "4.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.6",
    "stockfish": "19.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "fake-indexeddb": "6.2.8",
    "oxlint": "1.92.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
